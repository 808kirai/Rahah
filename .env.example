# copy this file to .env and fill in your key from platform.claude.com
ANTHROPIC_API_KEY=

# optional settings, the values shown are the defaults
# leave RAHAH_MODEL out for the model picker, Acolyte, Mage and Archmage
# set it to one model to use that for everything, whatever the picker says
# RAHAH_MODEL=claude-haiku-5-5
# RAHAH_LIGHT_MODEL=claude-haiku-5-5
# RAHAH_DEEP_MODEL=claude-sonnet-5-5
# RAHAH_TOP_MODEL=claude-opus-5-5
# seconds acolyte gets to start before mage is asked instead, 0 turns it off
# RAHAH_STALL_SECONDS=20
# RAHAH_EFFORT=medium
# RAHAH_DB=data/rahah.db
# RAHAH_MAX_UPLOAD_MB=30
# RAHAH_DAILY_CAP=0.50

# sign in with google, a client id from console.cloud.google.com, leave blank to hide the button
# GOOGLE_CLIENT_ID=
# sign in with apple, a services id from developer.apple.com, needs a paid developer account and an https address
# APPLE_CLIENT_ID=

# where students write for help and password resets
# RAHAH_SUPPORT_EMAIL=studywithrahah@gmail.com

# security, set the admin email and https before going online
# RAHAH_ADMIN_EMAIL=you@example.com
# RAHAH_HTTPS=1
# RAHAH_DAILY_BUDGET=10
# RAHAH_SIGNUPS_PER_IP=20
# RAHAH_MAX_RUNNING=2
# online behind a host's proxy, the header holding the visitor's own address, true-client-ip on render
# RAHAH_CLIENT_IP_HEADER=true-client-ip
