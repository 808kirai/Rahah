# copy this file to .env and fill in your key from platform.claude.com
ANTHROPIC_API_KEY=

# optional settings, the values shown are the defaults
# RAHAH_MODEL=claude-opus-5-5
# RAHAH_EFFORT=medium
# RAHAH_DB=data/rahah.db
# RAHAH_MAX_UPLOAD_MB=30
# RAHAH_DAILY_CAP=0.50

# sign in with google, a client id from console.cloud.google.com, leave blank to hide the button
# GOOGLE_CLIENT_ID=
# sign in with apple, a services id from developer.apple.com, needs a paid developer account and an https address
# APPLE_CLIENT_ID=
